# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
env/
.pytest_cache/
.ipynb_checkpoints/

# Credenciales (nunca versionar; plantilla en .env.example)
.env
*.env

# Frontend
node_modules/
frontend/.ui-test/

# Editores y sistema
.vscode/
.streamlit/secrets.toml
.DS_Store
Thumbs.db

# Registros y salidas de herramientas bioinformáticas
logs/
*.log
fimo_out/
blast_out/
*.fai
*.bt2

# Datos: todo data/ se regenera (make cache-atlas, make metrics-atlas, ...) y no se versiona.
# Excepción: el caché del MVP, que necesita `make mvp`.
# Los archivos de data/results/mvp/ que ya están en git (report.md, *.provenance.json) se agregaron con
# `git add -f` y siguen versionados; para actualizar el informe: git add -f data/results/mvp/report.md
data/*
!data/cache/
data/cache/*
!data/cache/mvp/

# Documentación interna (bitácoras, contexto, semanas, evidencias, preguntas, CLAUDE.md): solo en el servidor
# (decisión del 26-11-2026). En GitHub queda solo lo necesario para instalar y usar el proyecto.
docs/*
!docs/requisitos_y_datos.md
CLAUDE.md
