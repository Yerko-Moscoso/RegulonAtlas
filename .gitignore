# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
env/
.pytest_cache/
.ipynb_checkpoints/

# Credenciales (nunca versionar; plantilla en .env.example)
.env
*.env

# Frontend
node_modules/

# Editores y sistema
.vscode/
.streamlit/secrets.toml
.DS_Store
Thumbs.db

# Registros y salidas de herramientas bioinformáticas
logs/
*.log
fimo_out/
blast_out/
*.fai
*.bt2

# Datos: todo data/ se regenera (make cache-atlas, make metrics-atlas, ...) y no se versiona.
# Excepción: el caché del MVP, que necesita `make mvp`.
# Los archivos de data/results/mvp/ que ya están en git (report.md, *.provenance.json) se agregaron con
# `git add -f` y siguen versionados; para actualizar el informe: git add -f data/results/mvp/report.md
data/*
!data/cache/
data/cache/*
!data/cache/mvp/

# Evidencia de las pruebas de aceptación del MVP: se conserva solo en el servidor (decisión del 26-10-2026).
# Se versiona únicamente el registro formal.
docs/evidencia_mvp/*
!docs/evidencia_mvp/pruebas_aceptacion_mvp.md

# Evidencia de la prueba de reproducibilidad del atlas: solo en el servidor (29-10-2026). Se versiona el registro.
docs/evidencia_reproducibilidad/*
!docs/evidencia_reproducibilidad/prueba_reproducibilidad_atlas.md

# Evidencia de la revisión completa de la semana 13 (registros y capturas): solo en el servidor (29-10-2026).
docs/evidencia_revision_semana13/

# Prueba desde cero (semana 14): Excel, registros y capturas solo en el servidor (04-11-2026). Se versiona el registro.
docs/evidencia_instalacion/*
!docs/evidencia_instalacion/prueba_desde_cero.md
